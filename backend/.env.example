# Firebase Admin SDK — get service account from Firebase Console → Project Settings → Service Accounts
# Option 1: Paste the entire JSON as a single-line string (best for Vercel env vars)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Option 2: Path to JSON file (best for local dev)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Google Gemini (optional — runs in mock mode without it)
GEMINI_API_KEY=your_gemini_api_key_here

# Amazon RapidAPI (optional)
# RAPIDAPI_KEY=your_rapidapi_key_here
